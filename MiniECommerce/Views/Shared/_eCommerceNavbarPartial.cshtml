@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<nav class="navbar bg-dark navbar-expand-lg sticky-top">
    <div class="container-fluid">

        <a class="navbar-brand nav-logo fw-light text-light" asp-controller="Home" asp-action="Index">
            ShopHub <span class="logo-dot"></span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <i class="fa-solid fa-burger" style="color: rgb(245, 212, 59);"></i>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
            <ul class="navbar-nav gap-2 align-items-md-end mt-3 mt-lg-0">

                @if (!User.Identity!.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="btn btn-admin fw-bold rounded-pill btn-sm" asp-area="Admin" asp-controller="Account" asp-action="AdminLogin">
                            Admin Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-customer fw-bold rounded-pill btn-sm" asp-area="Customer" asp-controller="Account" asp-action="Login">
                            Customer Login
                        </a>
                    </li>
                }
                else
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                Admin Dashboard 🔰
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-area="Admin" asp-controller="Account" asp-action="AdminLogout" method="post">
                                <button type="submit" class="btn btn-danger">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-secondary" style="font-style:italic;" asp-area="Customer" asp-controller="Catalog" asp-action="Index">
                                SHOP NOW 🛒
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-area="Customer" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-danger">Logout</button>
                            </form>
                        </li>
                    }
                }

            </ul>
        </div>

    </div>
</nav>