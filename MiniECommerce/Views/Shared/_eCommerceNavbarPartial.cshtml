@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">eCommerce</a>

        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                @* <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </li> *@
            </ul>

            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-3">
                @if (!User.Identity!.IsAuthenticated) // if not authenticated yet
                {
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Account" asp-action="AdminLogin">
                            Admin Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-outline-secondary" asp-area="Customer" asp-controller="Account" asp-action="Login">
                            Customer Login
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <form asp-area="Admin" asp-controller="Account" asp-action="AdminLogout" method="post">
                            <button type="submit" class="btn btn-danger">Logout</button>
                        </form>
                    </li>
                    @if (User.IsInRole("Admin")) 
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                Admin Dashboard 🔰
                            </a>
                        </li>
                    }
                    else // not auth and not admin 
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-secondary" asp-area="Customer" asp-controller="Account" asp-action="Login">
                                Customer Dashboard 🌐
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</nav>