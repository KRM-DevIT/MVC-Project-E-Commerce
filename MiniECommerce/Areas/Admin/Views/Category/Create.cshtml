@model CategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<h2 class="mb-4">Create New Category</h2>

<div class="row">
    <div class="col-md-6">

        <form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>

            <div class="mb-3">

                <label asp-for="ParentCategoryId" class="form-label">
                    Choose Daddy Category
                </label>

                <select asp-for="ParentCategoryId"
                        asp-items="Model.Categories"
                        class="form-select">

                    <option value="">No Parent Category</option>

                </select>

            </div>

            <button type="submit" class="btn btn-primary">
                Create Category
            </button>

            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}