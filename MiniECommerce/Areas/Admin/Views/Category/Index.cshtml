@model List<Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Categories</h2>

        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-primary">
            + Create Category
        </a>

    </div>


    <div class="row row-cols-1 row-cols-md-3 g-4">

        @foreach (var category in Model)
        {
            <div class="col">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">

                        <h5 class="card-title">
                            @category.CategoryName
                        </h5>

                        <p class="card-text text-muted">

                            @if (category.ParentCategoryId == null)
                            {
                                <span>No Parent Category</span>
                            }
                            else
                            {
                                <span>Parent Category: @category.ParentCategory?.CategoryName</span>
                            }

                        </p>

                    </div>


                    <div class="card-footer bg-transparent d-flex justify-content-between">

                        <a asp-area="Admin" asp-controller="Category" asp-action="Edit"
                           asp-route-id="@category.CategoryId"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-area="Admin" asp-controller="Category" asp-action="Details"
                           asp-route-id="@category.CategoryId"
                           class="btn btn-sm btn-outline-info">
                            Details
                        </a>

                        <a asp-area="Admin" asp-controller="Category" asp-action="Delete"
                           asp-route-id="@category.CategoryId"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>