@model Product
@using MiniECommerce.Results
@{
    ViewData["Title"] = "Product Details";
    var stockStatus = Model.StockQuantity == 0 ? ("Out of Stock", "danger")
                    : Model.StockQuantity <= 5 ? ("Critical", "warning")
                    : Model.StockQuantity <= 10 ? ("Low Stock", "warning")
                    : ("In Stock", "success");
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-0">Product Details</h2>
        <p class="text-muted small mb-0">Viewing full information for this product.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.ProductId"
           class="btn btn-dark">✏️ Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">

    <!-- Left: image + status -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.ProductName"
                         class="w-100 rounded-top"
                         style="height: 280px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light rounded-top d-flex align-items-center
                                    justify-content-center"
                         style="height: 280px;">
                        <span class="text-muted">🖼️ No image</span>
                    </div>
                }
            </div>
            <div class="card-footer bg-white">

                <!-- Active badge -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">STATUS</span>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>

                <!-- Stock badge -->
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-muted small fw-semibold">STOCK</span>
                    <span class="badge bg-@stockStatus.Item2">
                        @Model.StockQuantity units — @stockStatus.Item1
                    </span>
                </div>

            </div>
        </div>
    </div>

    <!-- Right: all details -->
    <div class="col-lg-8 d-flex flex-column gap-3">

        <!-- Core info -->
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0">📦 Product Information</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">

                    <dt class="col-sm-4 text-muted small">Product Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.ProductName</dd>

                    <dt class="col-sm-4 text-muted small">SKU</dt>
                    <dd class="col-sm-8">
                        <code class="bg-light px-2 py-1 rounded">@(Model.SKU ?? "—")</code>
                    </dd>

                    <dt class="col-sm-4 text-muted small">Category</dt>
                    <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "—")</dd>

                    <dt class="col-sm-4 text-muted small">Price</dt>
                    <dd class="col-sm-8 fw-bold text-success fs-5">
                        $@Model.CurrentPrice.ToString("N2")
                    </dd>

                    <dt class="col-sm-4 text-muted small">Description</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No description provided.</span>
                        }
                    </dd>

                </dl>
            </div>
        </div>

        <!-- Inventory + metadata -->
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0">📊 Inventory & Metadata</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">

                    <dt class="col-sm-4 text-muted small">Stock Quantity</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-@stockStatus.Item2 me-1">
                            @stockStatus.Item1
                        </span>
                        @Model.StockQuantity units
                    </dd>

                    <dt class="col-sm-4 text-muted small">Visibility</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="text-success fw-semibold">✓ Visible in store</span>
                        }
                        else
                        {
                            <span class="text-secondary">✗ Hidden from store</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted small">Created At</dt>
                    <dd class="col-sm-8">
                        @Model.CreatedAt.ToString("MMM dd, yyyy — hh:mm tt")
                    </dd>

                </dl>
            </div>
        </div>

        <!-- Danger zone -->
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h6 class="mb-0">⚠️ Danger Zone</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="fw-semibold">Delete this product</div>
                    <div class="text-muted small">
                        This action is permanent and cannot be undone.
                    </div>
                </div>
                <form asp-action="Delete" asp-route-id="@Model.ProductId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to delete @Model.ProductName?')">
                        🗑️ Delete
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>
