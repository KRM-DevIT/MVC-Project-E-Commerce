@model ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-0">Products</h2>
        <p class="text-muted small mb-0">@Model.TotalCount products total</p>
    </div>
    <a asp-action="Create" class="btn btn-dark">+ Add Product</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Products.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="fs-5">No products yet.</p>
        <a asp-action="Create" class="btn btn-dark">Add your first product</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">

                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl"
                             alt="@product.ProductName"
                             class="card-img-top"
                             style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height: 200px;">
                            <span class="text-muted">🖼️ No image</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">

                        <span class="badge bg-secondary mb-2 align-self-start">
                            @(product.Category?.CategoryName ?? "Uncategorized")
                        </span>

                        <h5 class="card-title fw-bold mb-1">@product.ProductName</h5>

                        <p class="card-text text-muted small flex-grow-1"
                           style="overflow:hidden;display:-webkit-box;
                                          -webkit-line-clamp:2;-webkit-box-orient:vertical;">
                            @(product.Description ?? "No description.")
                        </p>

                        <div class="d-flex align-items-center justify-content-between mt-2 mb-2">
                            <span class="fw-bold text-success fs-5">
                                $@product.CurrentPrice.ToString("N2")
                            </span>
                            @{
                                var (stockLabel, stockColor) =
                                product.StockQuantity == 0 ? ("Out of Stock", "danger")
                                : product.StockQuantity <= 5 ? ("Critical", "warning")
                                : product.StockQuantity <= 10 ? ("Low Stock", "warning")
                                : ("In Stock", "success");
                            }
                            <span class="badge bg-@stockColor">
                                @product.StockQuantity — @stockLabel
                            </span>
                        </div>

                        <div class="mb-3">
                            @if (product.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    ✓ Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    ✗ Inactive
                                </span>
                            }
                        </div>

                        <div class="d-flex gap-2 mt-auto">
                            <a asp-action="Details" asp-route-id="@product.ProductId"
                               class="btn btn-outline-dark btn-sm flex-grow-1">
                                🔍 Details
                            </a>
                            <a asp-action="Edit" asp-route-id="@product.ProductId"
                               class="btn btn-dark btn-sm flex-grow-1">
                                ✏️ Edit
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    <div class="d-flex flex-column align-items-center gap-3 mt-2">

        <span class="text-muted small">
            Page @Model.CurrentPage of @Model.TotalPages
            &nbsp;|&nbsp; @Model.TotalCount total products
        </span>

        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize">&laquo; Prev</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.PageSize">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize">Next &raquo;</a>
                </li>
            </ul>
        </nav>

        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <label class="mb-0 text-muted small">Go to page:</label>
            <input type="number" name="pageNumber"
                   min="1" max="@Model.TotalPages" value="@Model.CurrentPage"
                   class="form-control form-control-sm" style="width:70px;" />
            <button type="submit" class="btn btn-sm btn-outline-dark">Go</button>
        </form>

    </div>
}
