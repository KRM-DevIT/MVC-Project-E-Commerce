@model ProductCreateViewModel
@{
    ViewData["Title"] = "Create Product";
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-0">Add New Product</h2>
        <p class="text-muted small mb-0">Fill in the details to add a product to the catalog.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        &larr; Back to Products
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Please fix the following errors:</strong>
        <div asp-validation-summary="ModelOnly"></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-4">

        <!-- Left column: main fields -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0">📦 Product Information</h6>
                </div>
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label fw-semibold"></label>
                        <input asp-for="ProductName" class="form-control"
                               placeholder="e.g. Wireless Headphones" />
                        <span asp-validation-for="ProductName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control"
                                  rows="3" placeholder="Describe the product..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="CurrentPrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="CurrentPrice" class="form-control"
                                       type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="CurrentPrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                            <input asp-for="StockQuantity" class="form-control"
                                   type="number" min="0" placeholder="0" />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                        <select asp-for="CategoryId"
                                asp-items="Model.categories"
                                class="form-select">
                            <option value="">— Select a category —</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Image upload + live preview -->
                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="ImageFile" class="form-label fw-semibold"></label>
                            <input asp-for="ImageFile"
                                   class="form-control"
                                   type="file"
                                   accept=".jpg,.jpeg,.png"
                                   id="imageFileInput" />
                            <div class="form-text">JPG or PNG, max 3 MB.</div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Preview</label>
                            <div class="border rounded bg-light d-flex align-items-center
                                        justify-content-center overflow-hidden"
                                 style="height: 120px;">
                                <img id="previewImg" src="" alt="Preview"
                                     class="w-100 h-100 object-fit-fill d-none" />
                                <span id="previewPlaceholder"
                                      class="text-muted small text-center px-2">
                                    🖼️ Choose a file to preview
                                </span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Right column: settings + actions -->
        <div class="col-lg-4 d-flex flex-column gap-3">

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0">👁️ Visibility</h6>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input"
                               type="checkbox" role="switch" id="isActiveToggle" />
                        <label class="form-check-label" for="isActiveToggle">
                            Active — visible in store
                        </label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-danger small"></span>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0">💾 Save</h6>
                </div>
                <div class="card-body d-grid gap-2">
                    <button type="submit" class="btn btn-dark">✓ Save Product</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('imageFileInput').addEventListener('change', function () {
            const file        = this.files[0];
            const img         = document.getElementById('previewImg');
            const placeholder = document.getElementById('previewPlaceholder');

            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                img.classList.add('d-none');
                placeholder.classList.remove('d-none');
                placeholder.textContent = '🖼️ Choose a file to preview';
            }
        });
    </script>
}
