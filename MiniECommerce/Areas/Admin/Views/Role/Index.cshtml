@model List<ApplicationRole>

@{
    ViewData["Title"] = "Roles";
}

<h1>Role Management</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
     </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Role</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Description</th>
            <th>Image URL</th>
            <th>Normalized Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.RoleDescription</td>
                <td>@role.RoleImageURL</td>
                <td>@role.NormalizedName</td>
                
                <td>
                    <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-warning">Edit</a>
                    
                    <form asp-action="Delete" asp-route-id="@role.Id" method="post" style="display:inline">
                        
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?');">
                            Delete
                        </button>

                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>