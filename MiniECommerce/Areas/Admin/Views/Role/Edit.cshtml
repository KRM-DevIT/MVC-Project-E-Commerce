@model RoleViewModel

@{
    ViewData["Title"] = "Create Role";
}

<form asp-action="Edit" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
   
    <div class="form-group">
        <label asp-for="RoleName"></label>
        <input asp-for="RoleName" class="form-control" />
        <span asp-validation-for="RoleName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="RoleDescription"></label>
        <input asp-for="RoleDescription" class="form-control" />
        <span asp-validation-for="RoleDescription" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="RoleImageURL"></label>
        <input asp-for="RoleImageURL" class="form-control" />
        <span asp-validation-for="RoleImageURL" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>

</form>