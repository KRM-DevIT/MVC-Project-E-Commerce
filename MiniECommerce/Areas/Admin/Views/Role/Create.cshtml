@model RoleViewModel

@{
    ViewData["Title"] = "Create Role";
}

<div class="admin-page-header">
    <div>
        <span class="admin-eyebrow">Access management</span>
        <h1>Create a role</h1>
        <p>Define a clear responsibility and choose an icon for quick recognition.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-2"></i>All Roles
    </a>
</div>

<div class="admin-form-shell">
    <div class="card admin-form-card">
        <div class="admin-form-card-header">
            <div class="admin-form-icon" id="roleIconPreview">
                <i class="@Model.RoleImageURL"></i>
            </div>
            <div>
                <h2>Role details</h2>
                <p>Use a short name and a description that explains the role's purpose.</p>
            </div>
        </div>

        <div class="card-body p-4 p-lg-5">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 mb-4"
                     role="alert"></div>

                <div class="mb-3">
                    <label asp-for="RoleName" class="form-label fw-semibold"></label>
                    <input asp-for="RoleName" class="form-control"
                           placeholder="Example: Inventory Manager" />
                    <span asp-validation-for="RoleName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RoleDescription" class="form-label fw-semibold"></label>
                    <textarea asp-for="RoleDescription" class="form-control" rows="3"
                              placeholder="Describe what this role is responsible for."></textarea>
                    <span asp-validation-for="RoleDescription" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="RoleImageURL" class="form-label fw-semibold"></label>
                    <select asp-for="RoleImageURL" class="form-select">
                        <option value="fa-solid fa-user-shield">Administrator shield</option>
                        <option value="fa-solid fa-shield-halved">Security shield</option>
                        <option value="fa-solid fa-user-gear">Account manager</option>
                        <option value="fa-solid fa-headset">Customer support</option>
                        <option value="fa-solid fa-boxes-stacked">Inventory manager</option>
                        <option value="fa-solid fa-chart-line">Reports and analytics</option>
                    </select>
                    <span asp-validation-for="RoleImageURL" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-plus me-2"></i>Create Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const select = document.getElementById("RoleImageURL");
            const preview = document.querySelector("#roleIconPreview i");
            const updatePreview = () => preview.className = select.value;
            select.addEventListener("change", updatePreview);
            updatePreview();
        })();
    </script>
}
