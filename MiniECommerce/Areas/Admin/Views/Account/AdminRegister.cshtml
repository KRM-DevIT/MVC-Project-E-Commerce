@model AdminRegisterViewModel

@{
    ViewData["Title"] = "Create Admin";
}

<div class="admin-page-header">
    <div>
        <span class="admin-eyebrow">Access management</span>
        <h1>Create an admin account</h1>
        <p>Add a trusted team member with full store-management access.</p>
    </div>
    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-2"></i>Dashboard
    </a>
</div>

<div class="admin-form-shell">
    <div class="card admin-form-card">
        <div class="admin-form-card-header">
            <div class="admin-form-icon">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <div>
                <h2>Administrator details</h2>
                <p>The new account will be assigned to the Admin role.</p>
            </div>
        </div>

        <div class="card-body p-4 p-lg-5">
            <form asp-action="AdminRegister" method="post">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger py-2 mb-4"
                     role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <div class="input-group admin-input-group">
                            <span class="input-group-text">
                                <i class="fa-regular fa-user"></i>
                            </span>
                            <input asp-for="FirstName" class="form-control" placeholder="First name" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <div class="input-group admin-input-group">
                            <span class="input-group-text">
                                <i class="fa-regular fa-user"></i>
                            </span>
                            <input asp-for="LastName" class="form-control" placeholder="Last name" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group admin-input-group">
                            <span class="input-group-text">
                                <i class="fa-regular fa-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control"
                                   autocomplete="off" placeholder="admin@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group admin-input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input asp-for="Password" class="form-control"
                                   autocomplete="new-password" placeholder="Create password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <div class="input-group admin-input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-check"></i>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control"
                                   autocomplete="new-password" placeholder="Repeat password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="admin-form-note mt-4">
                    <i class="fa-solid fa-circle-info"></i>
                    Use at least 8 characters with uppercase, lowercase, a number, and a symbol.
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                       class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-user-plus me-2"></i>Create Admin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
