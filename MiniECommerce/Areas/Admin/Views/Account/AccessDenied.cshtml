@{
    ViewData["Title"] = "Access Denied";
    Layout = null; // No layout for this page
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger">Access Denied</h1>
    @if (User.IsInRole(ApplicationRoles.DemoAdmin))
    {
        <p class="lead">The Demo Admin account has read-only access.</p>
        <a class="btn btn-primary"
           asp-controller="Dashboard" asp-action="Index">
            Back to Dashboard
        </a>
    }
    else
    {
        <p class="lead">You do not have permission to access this page.</p>
        <a class="btn btn-primary" asp-action="AdminLogin">Go to Login</a>
    }
</div>
