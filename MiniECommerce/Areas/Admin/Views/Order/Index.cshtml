@using MiniECommerce.DTO;
@using MiniECommerce.Results;
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@model OrderList

@{
    ViewData["Title"] = "Orders";
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold mb-0">Orders</h2>
        <p class="text-muted small mb-0">@Model.Orders.Count orders total</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetTokens(ViewContext.HttpContext).RequestToken" />

@if (!Model.Orders.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="fs-5">No orders yet.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 40px;"></th>  @* expand toggle *@
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Update Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        var rowId = $"expand-{order.OrderId}"; @*On-Fly RowId*@

                        @* ── Main row ── *@
                        <tr class="cursor-pointer" style="cursor:pointer;" onclick="toggleExpand('@rowId')">

                            <td class="text-center">
                                <span id="icon-@order.OrderId" class="text-muted" style="font-size:.75rem;">▶</span> @*each-element got this we catch it below to flip*@
                            </td>


                            <td>
                                <span class="fw-semibold">@order.OrderNumber</span>
                            </td>


                            <td>
                                <div class="fw-semibold">@order.CustomerName</div>
                                <div class="text-muted small">@order.CustomerEmail</div>
                            </td>


                            <td class="text-muted small">
                                @order.OrderDate.ToString("MMM dd, yyyy")<br />
                                <span>@order.OrderDate.ToString("hh:mm tt")</span>
                            </td>


                            <td class="fw-bold text-success">
                                $@order.TotalAmount.ToString("N2")
                            </td>


                            <td>
                                @{
                                    var (badgeClass, badgeLabel) = order.Status switch
                                    {
                                        OrderStatus.Placed => ("primary", "Placed"),
                                        OrderStatus.OutForDelivery => ("warning", "Out for Delivery"),
                                        OrderStatus.delivered => ("success", "Delivered"),
                                        OrderStatus.Cancelled => ("danger", "Cancelled"),
                                        _ => ("secondary", order.Status.ToString())
                                    };
                                }
                                <span class="badge bg-@badgeClass">@badgeLabel</span>
                            </td>




                            @* ── Inline status form — stop row click propagation *@

                            <td onclick="event.stopPropagation()"> @*We need this because the whole tr is clickable so we add this to stop the propagation when changing status *@

                                <select class="form-select form-select-sm order-status"
                                        style="width:auto"
                                        data-order-id="@order.OrderId"
                                        asp-items="Html.GetEnumSelectList<OrderStatus>()">
                                    @* This Code is similar to select list item in Drobdownlist but for enums(post enum number and modelstate auto cast it back *@

                                </select>

                            </td>


                        </tr>

                        @* ── Expanded row — hidden by default ── *@
                        <tr id="@rowId" class="d-none bg-light">
                            <td colspan="7" class="px-4 py-3">
                                <div class="row g-3">

                                    @* Shipping address *@
                                    <div class="col-md-4">
                                        <div class="fw-semibold small text-muted mb-1">
                                            📦 SHIPPING ADDRESS
                                        </div>
                                        <div class="small">
                                            @(order.ShippingAddress ?? "No address on record.")
                                        </div>
                                    </div>

                                    @* Order items *@
                                    <div class="col-md-8">
                                        <div class="fw-semibold small text-muted mb-1">
                                            🛒 ORDER ITEMS
                                        </div>
                                        @if (!order.Items.Any())
                                        {
                                            <span class="text-muted small">No items found.</span>
                                        }
                                        else
                                        {
                                            <table class="table table-sm table-bordered mb-0 bg-white">
                                                <thead class="table-secondary">
                                                    <tr>
                                                        <th>Product</th>
                                                        <th class="text-center">Qty</th>
                                                        <th class="text-end">Unit Price</th>
                                                        <th class="text-end">Line Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in order.Items)
                                                    {
                                                        <tr>
                                                            <td>@item.ProductName</td>
                                                            <td class="text-center">@item.Quantity</td>
                                                            <td class="text-end">$@item.UnitPrice.ToString("N2")</td>
                                                            <td class="text-end fw-semibold">$@item.LineTotal.ToString("N2")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot class="table-light">
                                                    <tr>
                                                        <td colspan="3" class="text-end fw-bold">Order Total</td>
                                                        <td class="text-end fw-bold text-success">
                                                            $@order.TotalAmount.ToString("N2")
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        }
                                    </div>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        function toggleExpand(rowId) 
        {
            const row     = document.getElementById(rowId);
            const orderId = rowId.replace('expand-', '');
            const icon    = document.getElementById('icon-' + orderId);

            const isHidden = row.classList.contains('d-none');
            row.classList.toggle('d-none', !isHidden);
            
            if(isHidden)
             {
                icon.textContent = '▼';
             }

            else
            {
                icon.textContent = '▶';
            }
        }
        var token = $('input[name="__RequestVerificationToken"]').val();
        $(document).on("change", ".order-status", function () {

            var myElement = $(this); // capture element that called for change

            var orderId = myElement.data("order-id"); // data-> access the value of an HTML data-order-id attribute
            var status = myElement.val(); //.val() method is used to get or set the value of HTML form elements

            $.ajax({
                url: 'Admin/Order/UpdateStatus',
                type: 'POST',
                data: 
                    {
                        __RequestVerificationToken: token,
                        orderId: orderId,
                        status: status
                    }
                  });
        });

    </script>
}
