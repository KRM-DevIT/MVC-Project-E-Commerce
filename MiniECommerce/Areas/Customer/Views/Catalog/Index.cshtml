                  success: function (response)
                 {
                     if(response.success)
                     {
                         $("#cartCount").text(response.count);
                     }
                 },

                  error: function ()
                    {
                        btn.prop("disabled", false);

                        alert("Couldn't add product to cart.");
                    }
             });
         }

          function validateSearch() {
            var input = document.getElementById('searchInput');
            var error = document.getElementById('searchError');

            if (input.value.trim() === '') {
                input.classList.add('is-invalid'); // Bootstrap class to show red border on input
                error.style.display = 'block';     // error message will be shown
                return false;
            } else {
                input.classList.remove('is-invalid');
                error.style.display = 'none';
                return true; 
            }
        }
    </script>
}