             {

                 // let existingItem = itemsList.find(item => item.productId === productId);

                 // if (!existingItem) 
                 // {
                 //     existingItem = { productId: productId, StockQuantity: stockQuantity, QuantityAdded: 1 };
                 //     itemsList.push(existingItem);
                 // } 
             
                 // else 
                 // {
                 //     if (existingItem.QuantityAdded < existingItem.StockQuantity) 
                 //     {
                 //         existingItem.QuantityAdded++;
                 //     }
                 // }


              let btn = $("#cartItem-" + productId);
              btn.prop('disabled', true);
              // if(existingItem.QuantityAdded >= existingItem.StockQuantity) nn case first time
              // {
              //    btn.prop('disabled', true);
              // }
              
             // var counter = parseInt(localStorage.getItem('cartCounter') || '0');
             // counter++;
             // localStorage.setItem('cartCounter', counter);
             // $("#cartCount").text(counter);


             $.ajax({
                 url: '@Url.Action("Add", "Cart", new { area = "Customer" })',
