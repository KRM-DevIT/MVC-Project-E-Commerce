@model CatalogViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Browse Products";
    bool isFiltered = Model.SelectedCategories.Any();
}

@section Styles {
    <link rel="stylesheet" href="~/css/CustomerCatalogStyle.css" asp-append-version="true" />
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="section-title">
            @if (isFiltered)
            {
                <span>Filtered Results</span>
            }
            else
            {
                <span class="gold-underline">Our Collection</span>
            }
        </h2>
        
        <p class="text-muted small mb-0">
            @Model.TotalCount product@(Model.TotalCount != 1 ? "s" : "") available  @*Perfectionist*@
        </p>

    </div>

    <form class="d-flex" asp-action="Search" onsubmit="return validateSearch();">

        <input type="hidden" name="pageSize" value="@Model.PageSize" />

        @foreach (var categoryId in Model.SelectedCategories)
        {
            <input type="hidden" name="Selectedcategories" value="@categoryId" />
        }

        <div class="me-2" style="position: relative;">
            <input id="searchInput" class="form-control" type="search" name="query" placeholder="Search" aria-label="Search">
            <div id="searchError" class="invalid-feedback" style="display:none;">
                Please enter a search term
            </div>
        </div>

        <button class="btn btn-outline-success" type="submit">Search</button>

    </form>

</div>



<div class="row g-4">

    <!-- ── Sidebar ── -->
    <aside class="col-lg-2 col-md-3">
        <div class="filter-sidebar">
            <div class="filter-title">Filters</div>

            <form method="get" asp-action="ProductsByCategory">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <div class="filter-section-label">Categories</div>

                @foreach (var category in Model.Categories)
                {
                    <div class="filter-check">
                        <input type="checkbox"
                               name="Selectedcategories"
                               value="@category.CategoryId"
                               id="cat-@category.CategoryId" @*for label association*@ 
                               @(Model.SelectedCategories.Contains(category.CategoryId) ? "checked" : "") />

                        <label for="cat-@category.CategoryId">
                            @category.CategoryName
                            <span class="cat-count">@category.Products.Count</span>
                        </label>
                    </div>
                }

                <button type="submit" class="btn-apply">Apply</button>

                @if (isFiltered)
                {
                    <a asp-action="Index" class="btn-clear">✕ Clear filters</a>
                }
            </form>
        </div>
    </aside>

    <!-- ── Products Grid ── -->
    <div class="col-lg-10 col-md-9">

        @*Upper Part that shows applied Filters*@
        @if (isFiltered)
        {
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="text-muted small">Filtered by:</span>
                @foreach (var id in Model.SelectedCategories)
                {
                    var cat = Model.Categories.FirstOrDefault(c => c.CategoryId == id);
                    if (cat != null)
                    {
                        <span class="badge rounded-pill bg-dark">@cat.CategoryName</span>
                    }
                }
            </div>
        }
        <!--Product Listing part-->
        @if (!Model.Products.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">🔍</div>
                <h4>No products found</h4>
                <p>Try adjusting your filters or browse all products.</p>
                <a asp-action="Index" class="btn-details d-inline-block px-4 mt-2">
                    Browse All
                </a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 mb-4">
                @foreach (var product in Model.Products)
                {
                    var outOfStock = product.StockQuantity == 0;

                    <div class="col">
                        <div class="product-card">

                            <!-- Image -->
                            <div class="card-img-wrap">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.ProductName" />
                                }
                                else
                                {
                                    <div class="no-image">🖼️ No image</div>
                                }
                                @if (product.Category != null)
                                {
                                    <span class="category-tag">@product.Category.CategoryName</span>
                                }
                            </div>

                            <!-- Body -->
                            <div class="card-body">
                                <div class="product-name">@product.ProductName</div>
                                <div class="product-desc">
                                    @(product.Description ?? "No description available.")
                                </div>

                                <div class="price-row">
                                    <span class="price">$@product.CurrentPrice.ToString("N2")</span>
                                    @if (outOfStock)
                                    {
                                        <span class="stock-badge bg-danger-subtle text-danger">
                                            Out of stock
                                        </span>
                                    }
                                    else if (product.StockQuantity <= 5)
                                    {
                                        <span class="stock-badge bg-warning-subtle text-warning">
                                            Only @product.StockQuantity left
                                        </span>
                                    }
                                </div>

                                <!-- Action buttons -->
                                <div class="card-actions">
                                    <a asp-area="Customer" asp-controller="Catalog" asp-action="Details" asp-route-id="@product.ProductId" class="btn-details">
                                        Details
                                    </a>

                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <form style="flex:2;" id="cartForm-@product.ProductId">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.ProductId" />
                                            <button type="button" class="btn-cart w-100" id="cartItem-@product.ProductId" @(outOfStock ? "disabled" : "")
                                                    onclick="increaseCounterAndAjax(@product.ProductId)">
                                                @(outOfStock ? "Unavailable" : "🛒 Add to Cart")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-area="Customer"  asp-controller="Account" asp-action="Login" class="btn-cart text-center text-decoration-none"
                                           style="line-height:2.2;">
                                            Login to Buy
                                        </a>
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="d-flex flex-column align-items-center gap-3 mt-2">

                <span class="text-muted small">
                    Page @Model.CurrentPage of @Model.TotalPages
                    &nbsp;|&nbsp; @Model.TotalCount product@(Model.TotalCount != 1 ? "s" : "")
                </span>

                <nav aria-label="Product pagination">
                    <ul class="pagination mb-0">

                        <li class="page-item @(!Model.HasPrevious ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="@(isFiltered ? "ProductsByCategory" : "Index")"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize">
                                &laquo; Prev
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="@(isFiltered ? "ProductsByCategory" : "Index")"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNext ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="@(isFiltered ? "ProductsByCategory" : "Index")"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize">
                                Next &raquo;
                            </a>
                        </li>

                    </ul>
                </nav>

                <form method="get"
                      asp-action="@(isFiltered ? "ProductsByCategory" : "Index")"
                      class="d-flex align-items-center gap-2">
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    @if (isFiltered)
                    {
                        @foreach (var id in Model.SelectedCategories)
                        {
                            <input type="hidden" name="Selectedcategories" value="@id" />
                        }
                    }
                    <label class="mb-0 text-muted small">Go to page:</label>
                    <input type="number" name="pageNumber"
                           min="1" max="@Model.TotalPages"
                           value="@Model.CurrentPage"
                           class="form-control form-control-sm"
                           style="width:70px;" />
                    <button type="submit" class="btn btn-sm btn-outline-dark">Go</button>
                </form>

            </div>
        }
    </div>
</div>

@section Scripts {

    <script>

        const cartProducts =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CartProductIds));

    </script>


    
    <script>
            
