@using Microsoft.AspNetCore.Identity
@inject MiniECommerce.Services.CartService CartService

<nav class="customer-nav">
    <div class="nav-inner">

        <!-- Logo -->
        <a asp-area="" asp-controller="Home" asp-action="Index"
           class="nav-logo">
            ShopHub<span class="logo-dot"></span>
        </a>

        <!-- Mobile toggle -->
        <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
            &#9776;
        </button>

        <!-- Links wrapper -->
        <div class="nav-links-wrapper" id="navLinksWrapper">

            @if (User.IsInRole("Customer"))
            {
                <!-- Customer navigation -->
                <ul class="nav-links">
                    <li>
                        <a asp-area="Customer" asp-controller="Catalog" asp-action="Index">
                           🔍 Browse
                        </a>
                    </li>
                    <li>
                        <a asp-area="Customer" asp-controller="Cart" asp-action="Index"
                           class="cart-link">
                            &#128722; Cart
                            <span class="cart-badge" id="cartCount">@CartService.GetAllCartItems().Count</span>
                        </a>
                    </li>
                    <li>
                        <a asp-area="Customer" asp-controller="Orders" asp-action="Index">
                            &#128203; My Orders
                        </a>
                    </li>
                    <li>
                        <form asp-area="Customer" asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-nav-logout">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            }
            else if (User.IsInRole("Admin"))
            {
                <!-- Administrator storefront preview -->
                <ul class="nav-links">
                    <li>
                        <span class="nav-preview-label">Storefront preview</span>
                    </li>
                    <li>
                        <a asp-area="Customer" asp-controller="Catalog" asp-action="Index">
                            Browse
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Product" asp-action="Index">
                            Manage products
                        </a>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                           class="btn-nav-login">
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <form asp-area="Admin" asp-controller="Account" asp-action="AdminLogout" method="post">
                            <button type="submit" class="btn-nav-logout">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            }
            else
            {
                <!-- Logged out -->
                <ul class="nav-links">
                    <li>
                        <a asp-area="Customer" asp-controller="Catalog" asp-action="Index">
                            Browse
                        </a>
                    </li>
                    <li>
                        <a asp-area="Customer" asp-controller="Account"
                           asp-action="Login" class="btn-nav-login">
                            Login
                        </a>
                    </li>
                    <li>
                        <a asp-area="Customer" asp-controller="Account"
                           asp-action="Register" class="btn-nav-register bg-info">
                            Register
                        </a>
                    </li>
                </ul>
            }

        </div>
    </div>
</nav>
