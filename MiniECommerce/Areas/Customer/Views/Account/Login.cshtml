@model CustomerLoginViewModel
@{
    ViewData["Title"] = "Welcome Back";
}

@section Styles {
    <link rel="stylesheet" href="~/css/CustomerLoginStyle.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mb-4 text-center" role="alert">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="auth-card">
            <div class="row g-0">

                <!-- Left: form -->
                <div class="col-lg-6 auth-left">

                    <div class="auth-title">Welcome back</div>
                    <p class="auth-subtitle">
                        Sign in to continue shopping your curated collection.
                    </p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            <div asp-validation-summary="ModelOnly"></div>
                        </div>
                    }

                    <form asp-area="Customer" asp-controller="Account"
                          asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control"
                                   autocomplete="username"
                                   placeholder="name@example.com" />
                            <label asp-for="Email">Email address</label>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Password" />
                            <label asp-for="Password">Password</label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="remember-row">
                            <label>
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                                Keep me signed in
                            </label>
                        </div>

                        <button type="submit" class="btn-auth">Sign In</button>

                        <div class="divider">or</div>

                        <div class="auth-footer-link">
                            Don't have an account?
                            <a asp-area="Customer" asp-controller="Account" asp-action="Register">
                                Create one
                            </a>
                        </div>

                    </form>
                </div>

                <!-- Right: decorative panel -->
                <div class="col-lg-6 auth-right d-none d-lg-flex">
                    <div class="auth-right-content">
                        <div class="big-quote">&ldquo;</div>
                        <h3>Style is a way to say who you are.</h3>
                        <p>
                            Discover products curated with care —
                            quality you can feel, prices you'll love.
                        </p>
                        <div class="decorative-dots">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
